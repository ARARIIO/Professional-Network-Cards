generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "cockroachdb"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card     Card?
  contacts Contact[]
  views    CardView[]
  invitesSent     ContactInvite[] @relation("InvitesSent")
  invitesReceived ContactInvite[] @relation("InvitesReceived")

  @@map("users")
}

model Card {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  role    String?
  email   String
  phone   String?
  website String?
  bio     String?

  skills   String[] @default([])
  linkedin String?
  github   String?
  twitter  String?

  avatarUrl       String?
  backgroundColor String  @default("#2e3a4e")

  slug     String  @unique
  isPublic Boolean @default(true)
  viewsCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views   CardView[]
  saves   Contact[]  @relation("CardSaves")
  invites ContactInvite[]

  @@index([userId])
  @@map("cards")
}

model Contact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  website String?
  bio     String?
  skills  String[] @default([])

  sourceCardId String?
  sourceCard   Card?     @relation("CardSaves", fields: [sourceCardId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([sourceCardId])
  @@map("contacts")
}

model ContactInvite {
  id     String @id @default(cuid())
  fromUserId String
  fromUser   User   @relation("InvitesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId String
  toUser   User   @relation("InvitesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  sourceCardId String
  sourceCard   Card   @relation(fields: [sourceCardId], references: [id], onDelete: Cascade)

  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, sourceCardId])
  @@index([toUserId, status])
  @@index([fromUserId])
  @@map("contact_invites")
}

model CardView {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?
  viewedAt  DateTime @default(now())

  @@index([cardId])
  @@index([userId])
  @@index([viewedAt])
  @@map("card_views")
}
