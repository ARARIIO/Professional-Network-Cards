{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/graphql",
      "destination": "https://pnc-api.onrender.com/graphql"
    },
    {
      "source": "/auth/refresh",
      "destination": "https://pnc-api.onrender.com/auth/refresh"
    },
    {
      "source": "/cards/:path*",
      "destination": "https://pnc-api.onrender.com/cards/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://pnc-api.onrender.com/storage/:path*"
    },
    {
      "source": "/contacts/:path*",
      "destination": "https://pnc-api.onrender.com/contacts/:path*"
    },
    {
      "source": "/health",
      "destination": "https://pnc-api.onrender.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
